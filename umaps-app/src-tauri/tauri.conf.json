{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UmaPS Admin",
  "version": "1.0.0",
  "identifier": "com.umaps.tracen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4321",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UmaPS Admin · Tracen Academy",
        "width": 1500,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 760,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
